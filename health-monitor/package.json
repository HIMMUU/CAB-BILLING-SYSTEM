{
  "name": "health-monitoring-module",
  "version": "1.0.0",
  "description": "Production-ready health monitoring module with retries, Prometheus metrics, structured logging, multi-channel alerting, and Render keep-alive support.",
  "main": "dist/index.js",
  "types": "dist/index.d.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "pinger": "ts-node src/pinger.ts",
    "start:pinger": "node dist/pinger.js",
    "pinger:pm2": "pm2 start ecosystem.config.js --env production",
    "pinger:stop": "pm2 stop backend-30s-pinger",
    "dev": "ts-node src/index.ts",
    "test": "jest --config jest.config.ts --runInBand",
    "test:coverage": "jest --config jest.config.ts --coverage"
  },
  "keywords": [
    "health-check",
    "monitoring",
    "prometheus",
    "retry",
    "backoff",
    "uptime",
    "render-keepalive"
  ],
  "author": "CABBS Team",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "nodemailer": "^6.10.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.10",
    "@types/nodemailer": "^6.4.17",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
